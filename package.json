{
  "name": "riscript",
  "version": "1.1.9",
  "author": "Daniel C Howe",
  "description": "generative language scripting",
  "homepage": "https://github.com/dhowe/riscript",
  "license": "GPL-3.0",
  "type": "module",
  "scripts": {
    "test": "NODE_ENV=dev mocha",
    "test:dist": "NODE_ENV=dev mocha test/dist",
    "lint": "eslint src/",
    "coverage": "c8 --all --src=src --reporter=text --reporter=lcov mocha",
    "build": "npx tsup",
    "pub": "npm whoami && npm test && npm run test:dist && npm version patch && npm publish && git push --follow-tags",
    "prepublishOnly": "npm run build",
    "types": "rm -rf types/generated && npx tsc && node parser-type-gen.js"
  },
  "main": "./dist/riscript.js",
  "types": "./dist/riscript.d.ts",
  "browser": "./dist/riscript.min.js",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/riscript.d.ts",
        "default": "./dist/riscript.js"
      },
      "require": {
        "types": "./dist/riscript.d.cts",
        "default": "./dist/riscript.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dhowe/riscript.git"
  },
  "engines": {
    "node": ">=18.18"
  },
  "keywords": [
    "natural language generation",
    "generative text"
  ],
  "bugs": {
    "url": "https://github.com/dhowe/riscript/issues"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/chai": "^4.3.9",
    "@types/mocha": "^10.0.3",
    "@types/node": "^20.8.9",
    "c8": "^12.0.0",
    "chai": "^4.3.10",
    "esbuild-plugin-version-injector": "^1.2.1",
    "eslint": "^10.12.0",
    "mocha": "^11.8.0",
    "rita": "^3.2.16",
    "tsup": "^8.5.1",
    "typescript": "^5.2.2"
  },
  "dependencies": {
    "chevrotain": "^11.2.0",
    "he": "^1.2.0",
    "mingo": "6.4.9"
  },
  "peerDependencies": {
    "rita": "^3.0"
  },
  "peerDependenciesMeta": {
    "rita": {
      "optional": true
    }
  },
  "overrides": {
    "lodash-es": "^4.18.1",
    "serialize-javascript": "^7.1.2",
    "diff": "^8.0.4"
  }
}
